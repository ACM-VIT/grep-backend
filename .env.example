# grep-backend configuration.
#
# Copy this file to `.env` and fill it in. Nothing here has a safe default that
# can be guessed, so the service refuses to start until the two required values
# are set. README.md explains where each one comes from.
#
#   cp .env.example .env

# ---------------------------------------------------------------- required

# The OAuth client ID from the Google Cloud console. Both this service and the
# website need the same value - the website reads it as PUBLIC_GOOGLE_CLIENT_ID.
# README.md → "Creating the Google sign-in key".
GOOGLE_CLIENT_ID=

# Who is allowed in. Comma-separated Google addresses; anything else is refused
# even with a valid Google account. This is the whole access-control model, so
# treat adding an address here as granting publish rights to the live site.
ADMIN_EMAILS=someone@acmvit.in,someone-else@acmvit.in

# ---------------------------------------------------------------- optional

# Where the service listens. Most hosts set PORT themselves - leave it alone
# unless you are running two copies on one machine.
PORT=8080

# Which site origins may call this from a browser. The admin page is served by
# the website, so the website's origin has to be listed here or the browser
# will block every request. No trailing slash. Comma-separated.
ALLOWED_ORIGINS=http://localhost:4321,https://grep.acmvit.in

# Where the JSON files and uploaded PDFs are written. Both must survive a
# restart - see README.md → "Backing it up" before deploying somewhere with an
# ephemeral filesystem.
DATA_DIR=./data
UPLOAD_DIR=./uploads

# This service's own public address, used to build the link to an uploaded
# file. Getting this wrong means uploads save fine and then 404 for readers.
PUBLIC_BASE_URL=http://localhost:8080

# Optional override for uploaded-file links alone. Set it when UPLOAD_DIR is
# mirrored to a bucket or sits behind a CDN, so stored links point there instead
# of at this process. Leave empty to serve files from PUBLIC_BASE_URL/files.
# e.g. https://storage.googleapis.com/grep-editions
PUBLIC_FILES_BASE_URL=
